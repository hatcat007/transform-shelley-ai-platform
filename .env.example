# Use a local/deployed PostgreSQL database. Never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Trusted Shelley base URL, no trailing /api. Model credentials belong in Shelley.
SHELLEY_API_URL=
# Optional bearer token for an authentication gateway.
SHELLEY_API_TOKEN=
# Set true in an HTTPS deployment.
COOKIE_SECURE=false
# Explicitly authorize evaluation spending before running live-evaluation.ts.
LIVE_EVAL_APPROVE=false
EVAL_MODEL=
